NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_BASE_URL=
NEXT_PUBLIC_APP_URL=
CRON_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
NOTION_TOKEN=
NOTION_PHONES_DATABASE_ID=
NOTION_DOMAINS_DATABASE_ID=
# Comma-separated ids, optionally with kind suffix: <id>:service|domain|phone
NOTION_EXTRA_DATABASE_IDS=
REQUIREMENTS_CHECK_MAX_PAGES=50
REQUIREMENTS_CHECK_MAX_DEPTH=4
SIMILARWEB_API_KEY=
SERANKING_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4o
OPENAI_TEXT_MODEL=gpt-4o
OPENAI_MAX_COST_PER_SCAN_USD=3
GOOGLE_PAGESPEED_API_KEY=
# Google Analytics Data API (server-side only). Use a service account.
GOOGLE_PROJECT_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Optional: path to a service account JSON instead of the pair above.
GOOGLE_APPLICATION_CREDENTIALS=
# Must match GA4 property timezone when possible.
APP_TIMEZONE=Europe/Kyiv
NEXT_PUBLIC_APP_TIMEZONE=Europe/Kyiv
# Local dev: leave monitor off while Render also checks the same Supabase DB.
ENABLE_LOCAL_MONITOR=
MONITOR_DISABLED=
# Local: leave empty (uses ~/Library/Caches/ms-playwright after `npx playwright install`)
# Render: /opt/render/project/src/.playwright-browsers (see render.yaml)
PLAYWRIGHT_BROWSERS_PATH=
# Traffic Creator Account API (server-side only). Settings → Developer API.
TRAFFIC_CREATOR_API_KEY=
# Optional override; default is https://traffic-creator.com/api/v1/account
TRAFFIC_CREATOR_API_BASE=
# Admin login gate (server-side only). Generate AUTH_SECRET with: openssl rand -base64 32
ADMIN_EMAIL=
ADMIN_PASSWORD=
AUTH_SECRET=

# Mail forwarder (Zoho inboxes → DESTINATION_EMAIL). SQLite, not Supabase.
DESTINATION_EMAIL=legal@todapay.com
SEND_METHOD=gmail
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=legal@todapay.com
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.eu
ZOHO_MAIL_BASE_URL=https://mail.zoho.eu
# Optional SMTP fallback when SEND_METHOD=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=legal@todapay.com
# SMTP_PASSWORD=
POLL_INTERVAL_SECONDS=60
LOOKBACK_HOURS=24
INITIAL_IMPORT=0
MAX_MESSAGES_PER_POLL=50
# Local Mac path will not work on Render. Use a path inside the app (or a Render disk).
SQLITE_PATH=.data/mail-forwarder.db
MAILBOXES_FILE=config/mailboxes.json
MAIL_FORWARDER_DISABLED=
